[Unit]
Description=Musicem Telegram Music Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/syns4033-jb/musicem-bot
ExecStart=/root/syns4033-jb/musicem-bot/.venv/bin/python /root/syns4033-jb/musicem-bot/bot.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
